# 复制为 crawler/.env 后填写（.env 已 gitignore，绝不要提交）
# ------------------------------------------------------------------
# 网站 ingest API
PICOLAH_API_BASE=http://127.0.0.1:8787
PICOLAH_INGEST_KEY=pcl_dev_crawler_key

# LangChain 工具调用入口（必须与 web/.env 一致）
CRAWLER_TOOL_HOST=127.0.0.1
CRAWLER_TOOL_PORT=8790
CRAWLER_TOOL_TOKEN=pcl_dev_crawler_tool_key
CRAWLER_TOOL_SEARCH_CONCURRENCY=3

# Bright Data 账号
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_API_TOKEN=

# 抓取通道：api = Web Unlocker REST（推荐，能过 JS/风控）
#           proxy = ISP 代理（干净 IP，但不做解锁）
BRIGHTDATA_TRANSPORT=api

# api 模式
BRIGHTDATA_ZONE=web_unlocker1

# 可选全网扩展 scope:web；默认跨 Shopee / Lazada / Amazon SG，不使用 SERP。
# SERP 需另行开通专用 zone 后填写名称，默认留空；不能复用 Web Unlocker zone。
# 未配置时明确报告未配置，不自动开通或退回单平台冒充全网。
# SERP 发现多个网站的商品链接，Web Unlocker 再读取商品页核价。
BRIGHTDATA_SERP_ZONE=

# proxy 模式
BRIGHTDATA_PROXY_ZONE=isp_proxy1
BRIGHTDATA_PROXY_PASSWORD=
BRIGHTDATA_PROXY_HOST=http://brd.superproxy.io:44445

# Browser API（Scraping Browser）
BRIGHTDATA_BROWSER_CUSTOMER_ID=
BRIGHTDATA_BROWSER_ZONE=scraping_browser1
BRIGHTDATA_BROWSER_ZONE_PASSWORD=
BRIGHTDATA_BROWSER_HOST=brd.superproxy.io
BRIGHTDATA_BROWSER_PORT=9222

# Shopee 数据集（免登录，推荐）
# 在 Bright Data Marketplace 开通 “Shopee - products” 后，填入账号里的 dataset_id。
# 留空则回退到下面的浏览器 + 登录 cookie 方案。
BRIGHTDATA_SHOPEE_DATASET_ID=
# 每次筛选最多返回多少条（1-1000，默认 50）
BRIGHTDATA_SHOPEE_DATASET_LIMIT=50

# Shopee 浏览器
# auto = 有本地 Chrome 就用本地，否则用 Scraping Browser
CRAWLER_BROWSER=auto
# 本地 Chrome 是否走 ISP 代理；登录时默认直连更稳
CRAWLER_LOCAL_PROXY=on
# 登录状态文件，默认 crawler/.shopee-state.<market>.json
# SHOPEE_STORAGE_STATE=
