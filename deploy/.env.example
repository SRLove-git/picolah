# ── Production config for picolah.com ──────────────────
# Copy to /opt/picolah/.env (chmod 600) and edit secrets.
PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Shared secret for the crawler ingest API. Generate with: openssl rand -hex 24
INGEST_API_KEY=replace-me

# Same-origin in production; keep the list for future separate clients.
CORS_ORIGINS=https://picolah.com,https://www.picolah.com

# Hidden workspace entry (the public site at / is a decoy).
PICOLAH_ENTRY_PATH=/7hk9ho

# ── LLM (OpenAI-compatible) ────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_INTENT_MODEL=deepseek-chat
LLM_VISION_MODEL=deepseek-flash
LLM_PROVIDER=DeepSeek

# Optional: absolute SQLite path. compose pins /app/data/picolah.db so the
# host mount ./data keeps the existing database; the image default is /app/web/data.
# PICOLAH_DB_PATH=/app/data/picolah.db

# ── Mock crawler (picolah-mock service) ────────────────
# 120s between batches, 8 offers per batch; state lives in ./mock-state.
MOCK_INTERVAL_MS=120000
MOCK_BATCH_SIZE=8
# MOCK_MARKETS=SG,MY

# ── Accounts and privacy ───────────────────────────────
# Production defaults to required; set false only for a private demo.
AUTH_REQUIRED=true
SESSION_DAYS=30

# ── Affiliate outbound links (optional) ────────────────
# Appended by /go/:offerId. Templates may use {url}, {rawUrl}, {platform}.
# AFFILIATE_SHOPEE_TEMPLATE=https://shope.ee/xxxx?sub_id={platform}
# AFFILIATE_LAZADA_TEMPLATE=https://c.lazada.sg/t/c.xxxx?sub_aff_id=picolah
# AFFILIATE_TIKTOK_TEMPLATE=
# AFFILIATE_AMAZON_SG_TEMPLATE=

# ── Price alerts / backups ─────────────────────────────
# Optional webhook (Slack/Telegram bridge); alerts are always stored in-app.
ALERT_WEBHOOK_URL=
BACKUP_KEEP=7

# ── Observability ──────────────────────────────────────
# Required in production to expose Prometheus metrics at /metrics.
# Generate with: openssl rand -hex 24
METRICS_TOKEN=replace-me
