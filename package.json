{
  "name": "picolah",
  "version": "0.1.0",
  "private": true,
  "description": "Picolah monorepo — the website lives in web/, the crawler lives in crawler/.",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:api": "npm --prefix web run dev:api",
    "dev:web": "npm --prefix web run dev:web",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "seed": "npm --prefix web run seed",
    "mock": "npm --prefix web run mock",
    "mock:once": "npm --prefix web run mock:once",
    "crawl": "npm --prefix crawler run crawl --",
    "test": "npm --prefix web run test",
    "typecheck": "npm --prefix web run typecheck"
  }
}
