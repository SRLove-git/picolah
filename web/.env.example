# ── Server ─────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Database: leave DATABASE_URL empty to use SQLite (PICOLAH_DB_PATH),
# or set a PostgreSQL URL to use PostgreSQL at runtime.
# DATABASE_URL=postgres://picolah:change-me@127.0.0.1:5432/picolah
# DATABASE_POOL_SIZE=10

# Shared secret for the separate crawler app.
# Send it as: Authorization: Bearer <key>
INGEST_API_KEY=pcl_dev_crawler_key

# Comma-separated origins allowed to call the API directly.
# Vite's dev proxy means the web app itself does not need CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Transactional email (sign-up / reset codes) ────────
# With no key, codes are printed to the server log instead of being sent.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Picolah <no-reply@picolah.com>"
# MAIL_CODE_SECRET=change-me-in-production

# ── LLM (OpenAI-compatible) ────────────────────────────
# Leave blank to use Picolah's deterministic local answer writer.
# DeepSeek V4.1 Flash (official API model id: deepseek-flash):
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_PROVIDER=DeepSeek
# Optional: model used for intent parsing and image recognition.
# LLM_INTENT_MODEL=deepseek-flash
# LLM_VISION_MODEL=deepseek-flash

# Or use any OpenAI-compatible endpoint, e.g.:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_PROVIDER=OpenAI

# ── AI try-on pictures (capybara) ──────────────────────
# One provider is enough; the key picks it automatically. Override the
# provider with IMAGE_PROVIDER=gemini|openai|dashscope.
#   gemini    → GEMINI_API_KEY      (default model gemini-2.5-flash-image)
#   openai    → OPENAI_API_KEY      (default model gpt-image-1)
#   dashscope → DASHSCOPE_API_KEY   (default model qwen-image-edit)
# With no key the feature reports "not configured" and stays hidden.
# IMAGE_GEN=off
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# DASHSCOPE_API_KEY=
# DASHSCOPE_IMAGE_MODEL=qwen-image-edit
# Per-visitor generations per hour.
IMAGE_RATE_PER_HOUR=6
# Where generated pictures live (defaults to <database dir>/media).
# PICOLAH_MEDIA_DIR=

# ── Real crawler LangChain tool ─────────────────────────
# Start it locally with: pnpm crawler:tool
# Runs for ordinary comparisons after a concrete product is confirmed, and for
# explicit freshness requests such as “实时刷新 Lazada 的最新价格”.
CRAWLER_TOOL_URL=http://127.0.0.1:8790
CRAWLER_TOOL_TOKEN=pcl_dev_crawler_tool_key
CRAWLER_TOOL_TIMEOUT_MS=420000
# Cache only verified page prices; TTL starts at the original verification time.
# Set 0 to disable caching and identical-request coalescing.
PRICE_SEARCH_CACHE_TTL_SECONDS=300
PRICE_SEARCH_CACHE_MAX_ENTRIES=200
CRAWLER_TOOL_MAX_PRODUCTS=2
# CRAWLER_SEARCH_SCOPE=platforms (overridden by chat web-price configuration below)
CRAWLER_TOOL_DEFAULT_PLATFORMS=shopee,lazada,amazon-sg

# Prometheus metrics at /metrics. Empty in development is open; in production
# set a long random token and scrape with Authorization: Bearer <token>.
# METRICS_TOKEN=

# Pico conversation web search (DeepSeek official Search API)
WEB_SEARCH_ENABLED=false
# Optional; defaults to the official DeepSeek LLM_API_KEY.
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_MS=20000

# Search product pages for current chat prices; Discover keeps its catalog policy.
CHAT_PRICE_SEARCH_SOURCE=web
CRAWLER_SEARCH_SCOPE=web
PRICE_SEARCH_PROVIDER=deepseek
